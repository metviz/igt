# igt reads the process environment only. Export these (or source a local .env) -- never commit .env.
# Results directory for --out. Required with --out; must be OUTSIDE this repository.
IGT_OUT_ROOT=/absolute/path/outside/repo/igt-results
# Optional Netscape cookies file for login-walled posts; a credential -- keep it OUTSIDE this repository.
IGT_COOKIES_FILE=/absolute/path/outside/repo/instagram-cookies.txt
